# sternuke — environment template
# Copy to `.env` and fill in. NEVER commit your real .env (it is gitignored).
#
# The ONLY credential needed to deploy (private GitHub repo + Release + GHCR image).
# Scopes required: repo, write:packages, read:packages
# Get it with:  gh auth refresh -h github.com -s write:packages,read:packages
#               export GITHUB_TOKEN="$(gh auth token)"
# or create a PAT at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: model used by the AI features / docker-compose (default: deepseek-coder)
# STERNUKE_MODEL=deepseek-coder
